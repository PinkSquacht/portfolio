# Example env vars for Credly
# Recommended: set `CREDLY_API_TOKEN` only in your deployment provider (Vercel) and do NOT commit your real token.

# Server-side token (set this in Vercel Project > Settings > Environment Variables)
CREDLY_API_TOKEN=your_server_side_credly_token_here

# Optional client-side token for local testing only (not recommended for production)
# If you use this, create a local `.env` file with the VITE_ prefix for Vite to pick it up:
# VITE_CREDLY_API_TOKEN=your_client_side_token_here

# Local dev note: using a client-side token exposes it to the browser. Prefer server-side proxy.
# Example env vars for Credly
# For local dev (exposes token to client) set the VITE var only for quick testing.
# Recommended: set CREDLY_API_TOKEN only in your deployment provider (Vercel) and leave VITE_CREDLY_API_TOKEN unset.

# Server-side token (do NOT commit your real token)
CREDLY_API_TOKEN=your_server_side_credly_token_here

# Optional client-side token for local testing only (not recommended for production)
VITE_CREDLY_API_TOKEN=your_client_side_token_here
